# 复制为 .env 后修改；不要把真实 API_KEY 提交到 Git
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL=qwen3-classical
BASE_MODEL=qwen3-base

# 必填：客户端使用 Authorization: Bearer <API_KEY>
API_KEY=change-me

# 单卡 8GB 下建议 1；调大后请求会排队/可能 OOM
MAX_CONCURRENCY=1
QUEUE_TIMEOUT=30
REQUEST_TIMEOUT=120
MAX_TOKENS=1024
DEFAULT_MAX_TOKENS=512
